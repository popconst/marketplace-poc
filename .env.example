# Optional settings for docker-compose.yml: copy to .env and uncomment what you change. Compose
# reads the ports and passes every variable to the backend containers; anything left out keeps
# the default shown. The README's Configuration section explains each one.

# Host ports.
POSTGRES_HOST_PORT=5432
WEB_HOST_PORT=8080

# Operations.
# RUST_LOG=info
# The demo routes under /api/dev, used by the frontend's Debug menu. Compose turns them on.
# DEV_TOOLS=true
# Applies to every backend container. The api defaults to 10, the worker to 2.
# DATABASE_MAX_CONNECTIONS=10
# WORKER_REFRESH_SECS=30
# CLOSE_MAX_ATTEMPTS=5

# Deal rules. Frozen on each campaign when it is published, so a change applies only to
# campaigns published afterwards.
# COMMISSION_BPS=1500
# USUAL_RATE_BASE_CENTS=9000
# USUAL_RATE_PER_1000_VIEWS_CENTS=1000
# FAIR_PAY_FLOOR_BPS=5000
# MAX_BID_SHARE_OF_BUDGET_BPS=2500
# VIEWS_TO_GET_PAID_BPS=3500
# LIKELY_VIEWS_LIMIT_BPS=6000
# DISCOVERY_BPS=1500

# Campaign limits. Read whenever a draft is saved or published.
# MIN_OFFER_BPS=5000
# MIN_BIDDING_HOURS=24
# MAX_BIDDING_HOURS=720
# POSTING_WINDOW_DEFAULT_DAYS=3
# POSTING_WINDOW_MAX_DAYS=7
